{
    "name": "cinghie/yii2-fontawesome",
    "description": "Asset Bundle to include Font Awesome on your Yii 2 project",
    "keywords": [
        "yii2 font",
        "yii2 font awesome",
        "yii2 Font Awesome",
        "yii2 fontawesome",
        "font awesome"
    ],
    "homepage": "https://github.com/cinghie/yii2-fontawesome",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Gogodigital.it",
            "email": "info@gogodigital.it",
            "homepage": "http://www.gogodigital.it/"
        }
    ],
    "require": {
        "yiisoft/yii2": "^2.0.14",
        "bower-asset/fontawesome": "^5.15.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5 || ^9.6 || ^10.5 || ^11.0",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "cinghie\\fontawesome\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "cinghie\\fontawesome\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
